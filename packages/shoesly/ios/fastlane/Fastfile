# --- flutter_prepare Lane ---
desc "Clean, get dependencies, fix issues, and format Flutter project"
lane :flutter_prepare do
  UI.important("🚀 Preparing Flutter project for liftoff! 🚀\n".green)

  # Cleaning
  start_time = Time.now
  UI.message("🧹 Cleaning Flutter project...".yellow)
  begin
    sh("flutter clean")
  rescue => ex
    UI.user_error!("Error during Flutter clean: #{ex.message}")
  end
  UI.success("  ✅ Cleaning Flutter project done in #{(Time.now - start_time).round(2)} seconds".green)

  # Dependencies
  start_time = Time.now
  UI.message("📦 Getting Flutter dependencies...".yellow)
  progressbar = ProgressBar.create(title: "Progress", total: nil, format: "%t: |%B|") # Animated progress bar
  begin
    sh("flutter pub get") do |status, output, pid|
      progressbar.increment if status == 0
    end
  rescue => ex
    UI.user_error!("Error during Flutter pub get: #{ex.message}")
  end
  progressbar.finish
  UI.success("  ✅ Getting Flutter dependencies done in #{(Time.now - start_time).round(2)} seconds".green)


  # fixing the unused import
  start_time = Time.now
  UI.message("🔧 Fixing Dart issues...".yellow)
  begin
    sh("dart fix --apply --code=unused_import")
  rescue => ex
    UI.user_error!("Error during Dart fix: #{ex.message}")
  end
  UI.success("  ✅ Fixing Dart issues done  in #{(Time.now - start_time).round(2)} seconds".green)

  # Formatting
  start_time = Time.now
  UI.message("✨ Formatting Dart code...".yellow)
  begin
    sh("dart format lib")
  rescue => ex
    UI.user_error!("Error during Dart format: #{ex.message}")
  end
  UI.success("  ✅ Formatting Dart code done in #{(Time.now - start_time).round(2)} seconds".green)

  # Final Success
  UI.success("""
-----------------------------------------
✅ Flutter Project Preparation Complete!
-----------------------------------------

Summary:
- Project cleaned
- Dependencies fetched
- Code formatted
""".green)

rescue => ex  # Catch any unexpected errors
  UI.user_error!("💥 An error occurred during Flutter project preparation: #{ex.message}", ex) 
end




## Release note for the user
desc "Get release notes from user input and store in ENV['RELEASE_NOTES']"
lane :get_release_notes_from_user do
  begin
    release_notes = "" # Initialize as empty
    while release_notes.strip.empty? do
      release_notes = UI.input("Enter release notes (required):")
      if release_notes.strip.empty?
        UI.important("Release notes cannot be empty. Please try again.")
      end
    end

    # Store in environment variable
    ENV["RELEASE_NOTES"] = release_notes

    UI.success("Release notes captured and stored in ENV['RELEASE_NOTES']:\n#{release_notes}")
  rescue => ex
    UI.user_error!("Error: #{ex.message}")
  end
end
